# ─── .env.example ─────────────────────────────────────────────────────────────
# Copy to .env.local (Next.js reads this automatically)
# NEVER commit .env.local to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ecommerce_next

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-change-me
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Redis (optional — app runs without cache if unavailable) ─────────────────
REDIS_URL=redis://localhost:6379

# ─── Docker Compose ───────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
